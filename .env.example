# ÆTHER-Grid Environment Configuration
# =====================================
# Copy this file to .env and fill in your values

# Environment
AETHER_ENVIRONMENT=development
AETHER_LOG_LEVEL=INFO
AETHER_DEBUG=false

# API Keys
AETHER_OPENAI_API_KEY=your-openai-api-key-here
AETHER_ANTHROPIC_API_KEY=your-anthropic-api-key-here
AETHER_IBMQ_API_KEY=your-ibmq-api-key-here

# Orchestrator
AETHER_ORCHESTRATOR__MAX_CONCURRENT_TASKS=10
AETHER_ORCHESTRATOR__TASK_TIMEOUT_SECONDS=300

# Quantum Configuration
AETHER_QUANTUM__BACKEND=aer_simulator
AETHER_QUANTUM__SHOTS=1024

# Vector Database
AETHER_VECTOR_DB__TYPE=chromadb
AETHER_VECTOR_DB__HOST=localhost
AETHER_VECTOR_DB__PORT=8000

# Feature Flags
AETHER_ENABLE_QUANTUM_OPTIMIZATION=false
AETHER_ENABLE_HITL_SAFETY_GATES=true
AETHER_ENABLE_A2A_PROTOCOL=true
